# BPC Busca de Áreas v0.3
# Copie este arquivo para .env.local e preencha somente as integrações que desejar usar.

# Motor de descoberta principal (recomendado)
BRAVE_SEARCH_API_KEY=

# Pesquisa/extracao estruturada e fallback de scraping
FIRECRAWL_API_KEY=

# Geocodificacao de producao
GOOGLE_MAPS_API_KEY=

# true = permite Nominatim/OSM como fallback local quando Google nao estiver configurado
ALLOW_NOMINATIM_FALLBACK=true
